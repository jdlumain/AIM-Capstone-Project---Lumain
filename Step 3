#Phase 3.1: Data Clean-up
# 1. Remove rows with missing CustomerID
df_cleaned = df.dropna(subset=['CustomerID'])

# 2. Remove duplicate transaction lines
df_cleaned = df_cleaned.drop_duplicates(subset=['InvoiceNo', 'StockCode', 'CustomerID', 'Quantity', 'UnitPrice', 'InvoiceDate'])

# 3. Filter out non-positive Quantity or UnitPrice
df_cleaned = df_cleaned[(df_cleaned['Quantity'] > 0) & (df_cleaned['UnitPrice'] > 0)]

# 4. Filter out non-product stock codes
non_product_codes = ['POST', 'D', 'M', 'BANK CHARGES', 'PADS', 'CRUK']
df_cleaned = df_cleaned[~df_cleaned['StockCode'].isin(non_product_codes)]

print(f"Original dataset shape: {df.shape}")
print(f"Cleaned dataset shape: {df_cleaned.shape}")
display(df_cleaned.head())

# 5. Add feature on total spend
df_cleaned['TotalSpend'] = df_cleaned['Quantity'] * df_cleaned['UnitPrice']


#Phase 3.2
import datetime as dt
from sklearn.preprocessing import StandardScaler

# 1. Domain-Derived Features: RFM Analysis
snapshot_date = df_cleaned['InvoiceDate'].max() + dt.timedelta(days=1)

rfm = df_cleaned.groupby('CustomerID').agg({
    'InvoiceDate': lambda x: (snapshot_date - x.max()).days,
    'InvoiceNo': 'count',
    'TotalSpend': 'sum'
})

rfm.rename(columns={'InvoiceDate': 'Recency',
                    'InvoiceNo': 'Frequency',
                    'TotalSpend': 'Monetary'}, inplace=True)

# 2. Binning: UnitPrice categories
df_cleaned['PriceRange'] = pd.qcut(df_cleaned['UnitPrice'], 3, labels=["Mass", "Average", "Affluent"])

# 3. Encoding: One-Hot Encoding for Country (Top 5)
top_countries = df_cleaned['Country'].value_counts().nlargest(5).index
df_cleaned['Country_Grouped'] = df_cleaned['Country'].apply(lambda x: x if x in top_countries else 'Other')
country_encoded = pd.get_dummies(df_cleaned['Country_Grouped'], prefix='Country')

# 4. Scaling
scaler = StandardScaler()
rfm_scaled = pd.DataFrame(scaler.fit_transform(rfm), index=rfm.index, columns=rfm.columns)

print("RFM Features (Scaled):")
display(rfm_scaled.head())
print("\nBinned Price Distribution:")
print(df_cleaned['PriceRange'].value_counts())

#Phase 3.3: Applied EDA

# 1.1. Check Skewness
print("Skewness in raw RFM data:")
print(rfm.skew())

# 1.2. Address Skewness using Log Transformation
# We add a small constant (1) to handle any potential 0 values
rfm_log = np.log(rfm + 1)

print("\nSkewness after Log Transformation:")
print(rfm_log.skew())

# 1.3. Standardize the Log-Transformed Features
scaler = StandardScaler()
rfm_final = pd.DataFrame(scaler.fit_transform(rfm_log), index=rfm.index, columns=rfm.columns)

print("\nFinal Standardized Data (Top 5 rows):")
display(rfm_final.head())

# 1.4. Visualization of distribution change
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))
