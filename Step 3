#2 Applying PCA 

from sklearn.decomposition import PCA

# Initialize PCA - we'll start by keeping all 3 components to see explained variance
pca = PCA(n_components=3)
pca_features = pca.fit_transform(rfm_final)

# Create a DataFrame for PCA results
pca_df = pd.DataFrame(pca_features, columns=['PC1', 'PC2', 'PC3'], index=rfm_final.index)

# Calculate and display explained variance ratio
explained_variance = pca.explained_variance_ratio_
print(f"Explained variance per component: {explained_variance}")
print(f"Total variance explained by first 2 components: {sum(explained_variance[:2]):.2%}")

# Display the top of the PCA dataframe
display(pca_df.head())

