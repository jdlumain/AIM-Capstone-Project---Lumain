#4 Clustering
# Merge cluster labels back to the original transaction data
df_clustered = df_cleaned.merge(rfm[['Cluster']], on='CustomerID', how='left')

# Identify top 5 products per cluster based on quantity sold
def get_top_products(group):
    return group.groupby(['StockCode', 'Description'])['Quantity'].sum().nlargest(5)

print("Top 5 Products per Cluster (Product Affinity):")
for cluster in sorted(df_clustered['Cluster'].unique()):
    print(f"\n--- Cluster {int(cluster)} ---")
    top_items = get_top_products(df_clustered[df_clustered['Cluster'] == cluster])
    print(top_items.to_string())

