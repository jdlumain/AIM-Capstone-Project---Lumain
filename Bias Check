# Define weights: Increasing Weight for Frequency to ensure it is not overshadowed
# Format: [Recency, Frequency, Monetary]
feature_weights = np.array([1.0, 1.5, 0.8])

# Apply weights to the standardized data
rfm_weighted = rfm_final * feature_weights

# Re-run K-Means with weighted features
kmeans_weighted = KMeans(n_clusters=3, init='k-means++', random_state=42, n_init=10)
weighted_clusters = kmeans_weighted.fit_predict(rfm_weighted)

# Add to a comparison dataframe
rfm['Weighted_Cluster'] = weighted_clusters

# Compare segment distributions
print("Original vs Weighted Cluster Distribution:")
print("Original:\n", rfm['Cluster'].value_counts().sort_index())
print("\nWeighted:\n", rfm['Weighted_Cluster'].value_counts().sort_index())

# Visualize shift in a 2D PCA space
pca_weighted = PCA(n_components=2)
pca_w_features = pca_weighted.fit_transform(rfm_weighted)

plt.figure(figsize=(10, 6))
sns.scatterplot(x=pca_w_features[:,0], y=pca_w_features[:,1], hue=rfm['Weighted_Cluster'], palette='plasma', alpha=0.6)
plt.title('Segments after Frequency-Weighted Scaling')
plt.xlabel('Weighted PC1')
plt.ylabel('Weighted PC2')
plt.grid(True)
plt.show()
